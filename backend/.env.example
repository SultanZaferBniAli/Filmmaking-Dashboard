PORT=4000
# Path to the import-data directory. Defaults to ../import-data (relative to backend/).
# Point this at a temp copy when testing to avoid writing to the real workbooks.
DATA_DIR=../import-data
MAX_UPLOAD_BYTES=10485760

# TMDB (The Movie Database) API key — used to look up movie poster images for trainers'
# filmography entries. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
