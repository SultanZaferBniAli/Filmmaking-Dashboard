PORT=4000
# Path to the import-data directory. Defaults to ../import-data (relative to backend/).
# Point this at a temp copy when testing to avoid writing to the real workbooks.
DATA_DIR=../import-data
MAX_UPLOAD_BYTES=10485760

# TMDB (The Movie Database) API key — used to look up movie poster images for trainers'
# filmography entries. Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Auth: two fixed accounts, no user database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=

# Random secret used to sign session JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Set to true once served over HTTPS in production, so the session cookie requires TLS.
COOKIE_SECURE=false

# Origin the frontend is served from — must match exactly for the session cookie to work
# (CORS rejects `origin: true` once credentials are involved).
FRONTEND_ORIGIN=http://localhost:5173
